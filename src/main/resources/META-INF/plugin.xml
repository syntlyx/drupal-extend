<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="false">
    <resource-bundle>messages.DrupalExtendBundle</resource-bundle>
    <id>com.github.nvelychenko.drupalextend</id>
    <name>Drupal Extend</name>
    <vendor>nvelychenko</vendor>
    <description><![CDATA[
<h1>Extends Drupal integration with PHPStorm.</h1>

<h2>Features</h2>

<ul>
    <li>Autocomplete for Content/Config Entity Storages, services, routes, fields, themes, attribute hooks, render element types and their properties</li>
    <li>References for Storages, services, routes, RenderElements, themes and Fields (Ctrl + Click)</li>
    <li>And much more. You can find list of all features <a href="https://github.com/nvelychenko/drupal-extend?tab=readme-ov-file#drupal-extend">here.</a></li>
</ul>

]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.FieldTypeIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.FieldPluginDefinitionIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.FieldPluginConfigUsageIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ConfigEntityIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ThemeIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.FieldsIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ContentEntityIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ContentEntityFqnIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.RenderElementIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.LibrariesIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.PermissionsIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ServicesIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.ServiceFactoryIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.RoutesIndex"/>
        <fileBasedIndex implementation="com.github.nvelychenko.drupalextend.index.LinksIndex"/>
        <fileType name="PHP" extensions="install"/>

        <psi.referenceContributor
                implementation="com.github.nvelychenko.drupalextend.reference.DrupalReferenceContributor"
                language="PHP"/>
        <psi.referenceContributor
                implementation="com.github.nvelychenko.drupalextend.reference.ServicesYamlReferenceContributor"
                language="yaml"/>
        <psi.referenceContributor
                implementation="com.github.nvelychenko.drupalextend.reference.RoutesYamlReferenceContributor"
                language="yaml"/>
        <findUsagesHandlerFactory
                implementation="com.github.nvelychenko.drupalextend.reference.ServicesYamlFindUsagesHandlerFactory"
                order="first"/>
        <findUsagesHandlerFactory
                implementation="com.github.nvelychenko.drupalextend.reference.RoutesYamlFindUsagesHandlerFactory"
                order="first"/>
        <referencesSearch
                implementation="com.github.nvelychenko.drupalextend.reference.ServicesReferencesSearch"
                order="first"/>
        <referencesSearch
                implementation="com.github.nvelychenko.drupalextend.reference.RoutesReferencesSearch"
                order="first"/>
        <gotoDeclarationHandler
                implementation="com.github.nvelychenko.drupalextend.reference.RoutesYamlGotoDeclarationHandler"
                order="first"/>
        <usageTargetProvider implementation="com.github.nvelychenko.drupalextend.reference.DrupalUsageTargetProvider"/>
        <gotoTargetPresentationProvider
                implementation="com.github.nvelychenko.drupalextend.reference.DrupalYamlTargetPresentationProvider"/>
        <implicitUsageProvider implementation="com.github.nvelychenko.drupalextend.usage.DrupalImplicitUsageProvider"/>
        <lang.inspectionSuppressor
                language="PHP"
                implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalPhpInspectionSuppressor"/>

        <annotator language="PHP" implementationClass="com.github.nvelychenko.drupalextend.psi.RenderElementAnnotator"/>
        <localInspection language="yaml"
                         shortName="DrupalServicesYaml"
                         displayName="Drupal services.yml problems"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.ServicesYamlInspection"/>
        <localInspection language="yaml"
                         shortName="DrupalRoutesYaml"
                         displayName="Drupal routing.yml problems"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.RoutesYamlInspection"/>
        <localInspection language="yaml"
                         shortName="DrupalInfoYaml"
                         displayName="Drupal info.yml problems"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalInfoYamlInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalRoutesPhp"
                         displayName="Drupal route call problems"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.RoutesPhpInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalDependencyInjection"
                         displayName="Drupal dependency injection suggestions"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalDependencyInjectionInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalPluginAttributes"
                         displayName="Drupal plugin annotations can be converted to attributes"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalPluginAttributeInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalTranslationPlaceholder"
                         displayName="Translation placeholder/argument mismatch"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalTranslationPlaceholderInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalHookMethodVisibility"
                         displayName="Drupal hook method must be public and non-static"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalHookMethodVisibilityInspection"/>
        <localInspection language="PHP"
                         shortName="DrupalCodeStyle"
                         displayName="Drupal code style"
                         groupName="Drupal Extend"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.nvelychenko.drupalextend.inspection.DrupalCodeStyleInspection"/>

        <completion.contributor order="first" language="PHP"
                                implementationClass="com.github.nvelychenko.drupalextend.completion.DrupalCompletionContributor"/>
        <completion.contributor order="last" language="PHP"
                                implementationClass="com.github.nvelychenko.drupalextend.completion.FieldMagicMethodCompletionContributor"/>
        <completion.contributor language="yaml"
                                implementationClass="com.github.nvelychenko.drupalextend.completion.ServicesYamlCompletionContributor"/>
        <completion.contributor language="yaml"
                                implementationClass="com.github.nvelychenko.drupalextend.completion.RoutesYamlCompletionContributor"/>
        <lang.documentationProvider language="yaml"
                                    order="first"
                                    implementationClass="com.github.nvelychenko.drupalextend.documentation.ServicesYamlDocumentationProvider"/>
        <lang.documentationProvider language="yaml"
                                    order="first"
                                    implementationClass="com.github.nvelychenko.drupalextend.documentation.RoutesYamlDocumentationProvider"/>

        <projectConfigurable
                instance="com.github.nvelychenko.drupalextend.project.configurable.DrupalConfig"
                displayName="Drupal Extend"
                id="com.github.nvelychenko.drupalextend.settings"
                bundle="messages.DrupalExtendBundle"
                parentId="reference.webide.settings.project.settings.php"
                nonDefaultProject="true"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.github.nvelychenko.drupalextend.schema.DrupalServicesSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.github.nvelychenko.drupalextend.schema.DrupalRoutingSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.github.nvelychenko.drupalextend.schema.DrupalPermissionsSchemaProviderFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.json">
        <catalog.exclusion implementation="com.github.nvelychenko.drupalextend.schema.DrupalServicesSchemaCatalogExclusion"/>
        <catalog.exclusion implementation="com.github.nvelychenko.drupalextend.schema.DrupalRoutingSchemaCatalogExclusion"/>
        <catalog.exclusion implementation="com.github.nvelychenko.drupalextend.schema.DrupalPermissionsSchemaCatalogExclusion"/>
        <jsonSchemaGotoDeclarationSuppressor implementation="com.github.nvelychenko.drupalextend.schema.DrupalServicesSchemaGotoDeclarationSuppressor"/>
        <jsonSchemaGotoDeclarationSuppressor implementation="com.github.nvelychenko.drupalextend.schema.DrupalRoutesSchemaGotoDeclarationSuppressor"/>
        <jsonSchemaGotoDeclarationSuppressor implementation="com.github.nvelychenko.drupalextend.schema.DrupalPermissionsSchemaGotoDeclarationSuppressor"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains.php">
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.EntityStorageTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.EntityFromStorageTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.StaticContentEntityTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.FieldItemListTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.EntityQueryTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.EntityReferenceFieldTypeProvider"/>
        <typeProvider4 implementation="com.github.nvelychenko.drupalextend.type.ServicesTypeProvider"/>

        <libraryRoot id="drupal-extend" path="/metadata" runtime="false"/>
    </extensions>

    <actions>
        <action id="DrupalExtend.FixDrupalCodeStyle"
                class="com.github.nvelychenko.drupalextend.action.FixDrupalCodeStyleAction"
                text="Fix Drupal Code Style"
                description="Reformat PHP and apply Drupal code style fixes">
            <add-to-group group-id="CodeMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <depends optional="true" config-file="drupal.xml">com.jetbrains.php.drupal</depends>
</idea-plugin>
