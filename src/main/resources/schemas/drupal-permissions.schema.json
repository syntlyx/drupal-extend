{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drupal-extend.local/schemas/drupal-permissions.schema.json",
  "title": "Drupal permissions.yml",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "permission_callbacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^(?!permission_callbacks$).+$": {
      "$ref": "#/definitions/permissionDefinition"
    }
  },
  "definitions": {
    "permissionDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "restrict access": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        }
      }
    }
  }
}
